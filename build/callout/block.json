{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sci-editorial/callout",
  "title": "SCI — Callout",
  "category": "design",
  "description": "Contenedor editorial para destacar información contextual.",
  "textdomain": "sci-editorial-blocks",
  "attributes": {
    "variant": {
      "type": "string",
      "default": "context"
    }
  },
  "style": "file:./style-index.css",
  "editorScript": [
    "wp-blocks",
    "wp-block-editor",
    "wp-components",
    "wp-i18n",
    "file:./index.js"
  ],
  "supports": {
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true
    }
  }
}