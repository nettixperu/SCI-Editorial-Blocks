{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sci-editorial/related",
  "title": "SCI — Relacionado",
  "category": "theme",
  "description": "Muestra automáticamente un artículo relacionado con la entrada actual.",
  "textdomain": "sci-editorial-blocks",
  "usesContext": [
    "postId",
    "postType"
  ],
  "render": "file:./render.php",
  "editorScript": [
    "wp-blocks",
    "wp-block-editor",
    "wp-i18n",
    "file:./index.js"
  ],
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontFamily": true,
      "fontSize": true,
      "lineHeight": true
    }
  }
}